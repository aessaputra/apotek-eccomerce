# Env variables
ENV=preview

# External API URLs (optional — defaults are set in app.config.ts)
# EXPO_PUBLIC_REGIONAL_API_URL=https://wilayah.id/api
# EXPO_PUBLIC_POSTAL_DATA_URL=https://raw.githubusercontent.com/ArrayAccess/Indonesia-Postal-And-Area/master/data/json/area/62
# EXPO_PUBLIC_GOOGLE_PLACES_API_URL=https://places.googleapis.com/v1
# EXPO_PUBLIC_GOOGLE_GEOCODING_API_URL=https://maps.googleapis.com/maps/api

# EXPO
EXPO_SLUG=apotek-ecommerce
EXPO_NAME="PREVIEW - SiFarma"
EXPO_PROJECT_ID=e6d087ad-de06-41af-8018-b6641e43d3d2
EXPO_IOS_BUNDLE_IDENTIFIER=com.apotekecommerce.preview
EXPO_ANDROID_PACKAGE=com.apotekecommerce.preview

# Firebase native config (EAS file variable recommended)
# Register Firebase Android/iOS apps for the preview identifiers above.
# GOOGLE_SERVICES_JSON=google-services.preview.json
# GOOGLE_SERVICES_PLIST=GoogleService-Info.preview.plist

# Google Maps (Maps SDK for Android/iOS is free — no billing charges for map display)
GOOGLE_MAPS_API_KEY=

# Google Places API New (v1) - for address autocomplete
# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Required APIs: Places API (New), Geocoding API
EXPO_PUBLIC_GOOGLE_API_KEY=

# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
